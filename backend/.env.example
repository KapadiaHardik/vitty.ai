# Application Environment
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Database (Neon / Supabase / Postgres with pgvector)
# Async driver: postgresql+asyncpg://user:password@host/dbname?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:your_password@ep-your-host.ap-southeast-1.aws.neon.tech/neondb?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://neondb_owner:your_password@ep-your-host.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# Local storage path or container temp path
STORAGE_DIR=./storage/documents

# LLM Configuration (Options: 'groq' | 'gemini' | 'openai' | 'ollama')
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=your_groq_api_key_here

# Embeddings (Options: 'gemini' | 'openai' | 'ollama')
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Optional if using provider 'openai')
OPENAI_API_KEY=

# Ollama (Optional fallback for local offline development)
OLLAMA_BASE_URL=http://localhost:11434

# Security
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
MAX_FILE_SIZE_MB=50
